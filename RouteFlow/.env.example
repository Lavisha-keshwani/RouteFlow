# Root environment for docker-compose. Copy to `.env` and adjust as needed.
# NEVER commit the real .env file.

# ---- PostgreSQL ----
POSTGRES_USER=routeflow
POSTGRES_PASSWORD=routeflow
POSTGRES_DB=routeflow

# ---- Backend ----
DATABASE_URL=postgresql+psycopg2://routeflow:routeflow@postgres:5432/routeflow
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MINUTES=1440
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
EMAIL_ENABLED=true
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@routeflow.app
SMS_ENABLED=false
SEED_ON_START=true

# ---- Frontend (build-time) ----
VITE_API_BASE_URL=http://localhost:8000/api
