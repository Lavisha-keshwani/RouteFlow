# ---- Application ----
APP_NAME=RouteFlow
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api

# ---- Database ----
# Zero-setup local option (no server needed) — great for a quick demo:
#   DATABASE_URL=sqlite:///./routeflow.db
# PostgreSQL (production / docker-compose service name is "postgres"):
DATABASE_URL=postgresql+psycopg2://routeflow:routeflow@localhost:5432/routeflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- Security / JWT ----
# Generate a strong secret, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
JWT_REFRESH_EXPIRATION_MINUTES=10080

# ---- CORS / Frontend ----
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Email notifications ----
# EMAIL_PROVIDER: console (logs) | smtp
EMAIL_ENABLED=true
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@routeflow.app
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- SMS notifications (optional; app works without these) ----
# SMS_PROVIDER: console | twilio
SMS_ENABLED=false
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=

# ---- Geocoding (optional) ----
GEOCODING_ENABLED=false
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=

# ---- Business (non-rate) configuration ----
VOLUMETRIC_DIVISOR=5000
ORDER_ID_PREFIX=RF
MAX_RESCHEDULE_ATTEMPTS=3
RATE_LIMIT_PER_MINUTE=120
